<Application x:Class="UsbLlm.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="Surface" Color="#111827" />
    <SolidColorBrush x:Key="Panel" Color="#172033" />
    <SolidColorBrush x:Key="Accent" Color="#5EEAD4" />
    <SolidColorBrush x:Key="Text" Color="#F8FAFC" />
    <SolidColorBrush x:Key="Muted" Color="#94A3B8" />
  </Application.Resources>
</Application>
