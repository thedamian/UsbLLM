<Window x:Class="UsbLlm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UsbLlm"
        Title="Usb LLM" Width="1440" Height="900" WindowState="Maximized"
        Background="{StaticResource Surface}" Foreground="{StaticResource Text}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="286" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#0B1220" BorderBrush="#26354D" BorderThickness="0,0,1,0" Padding="16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="USB LLM" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Accent}" />
          <TextBlock Text="Real Privacy with no Internet and no logging but full power"
                     Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,18" />
          <Button Content="＋ New private chat" Click="NewChat_Click" Padding="12,8" Background="#164E63" Foreground="White" BorderThickness="0" />
          <TextBlock Text="THIS SESSION" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,20,0,6" />
        </StackPanel>
        <ListBox x:Name="SessionsList" ItemsSource="{Binding Sessions}" DisplayMemberPath="Title"
                 SelectionChanged="SessionsList_SelectionChanged" Background="Transparent" BorderThickness="0" />
        <TextBlock DockPanel.Dock="Bottom" Text="Closing Usb LLM clears all chats. Export is always deliberate."
                   TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,16,0,0" />
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="28,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="ChatTitle" Text="New chat" FontSize="22" FontWeight="SemiBold" />
          <TextBlock x:Name="HardwareSummary" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <ComboBox x:Name="ModelSelector" Width="300" DisplayMemberPath="DisplayLabel" SelectionChanged="ModelSelector_SelectionChanged" />
          <Button Content="Export chat" Click="ExportCurrent_Click" Margin="10,0,0,0" Padding="10,6" />
          <Button Content="Export all" Click="ExportAll_Click" Margin="8,0,0,0" Padding="10,6" />
        </StackPanel>
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="MessagesList" ItemsSource="{Binding ActiveMessages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,14" Padding="14" CornerRadius="10" Background="#172033">
                <StackPanel>
                  <TextBlock Text="{Binding Speaker}" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,6" />
                  <local:MarkdownText Markdown="{Binding Body}" TextWrapping="Wrap" FontSize="15" />
                  <Border Background="#020617" Padding="12" Margin="0,12,0,0" CornerRadius="6" Visibility="{Binding CodeVisibility}">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="CODE" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" />
                        <Button Content="Copy" Tag="{Binding Code}" Click="CopyCode_Click" DockPanel.Dock="Right" Padding="7,2" />
                      </DockPanel>
                      <TextBox Text="{Binding Code}" IsReadOnly="True" FontFamily="Cascadia Code" FontSize="13" Background="Transparent"
                               Foreground="#E2E8F0" BorderThickness="0" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Border Grid.Row="2" Background="#172033" CornerRadius="10" Padding="12" Margin="0,18,0,0">
        <StackPanel>
          <ItemsControl x:Name="AttachmentsList" ItemsSource="{Binding ActiveAttachments}">
            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Accent}" Margin="0,0,0,6" /></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Button Content="Attach" Click="Attach_Click" Padding="10,7" />
              <Button Content="Image" Click="GenerateImage_Click" Margin="6,0,0,0" Padding="10,7" ToolTip="Uses image generation only when the selected local model supports it" />
            </StackPanel>
            <TextBox x:Name="PromptBox" Grid.Column="1" Margin="10,0" MinHeight="42" MaxHeight="160" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" />
            <Button x:Name="SendButton" Grid.Column="2" Content="Send" Click="Send_Click" Padding="16,7" Background="#0F766E" Foreground="White" BorderThickness="0" />
          </Grid>
          <TextBlock Text="Attachments and prompts remain only in memory. Images are sent only to models marked vision-capable."
                     Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
