<Window x:Class="UsbLlm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UsbLlm"
        Title="Usb LLM" Width="1440" Height="900" MinWidth="980" MinHeight="640"
        WindowState="Maximized" Background="#080E18" Foreground="#F8FAFC"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#080E18" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#0C1422" />
    <SolidColorBrush x:Key="PanelBrush" Color="#111C2D" />
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="#17253A" />
    <SolidColorBrush x:Key="LineBrush" Color="#24344A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#55D6C2" />
    <SolidColorBrush x:Key="TextBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="MutedBrush" Color="#91A2B8" />

    <Style x:Key="ButtonBaseStyle" TargetType="Button">
      <Setter Property="Foreground" Value="#DCE6F2" />
      <Setter Property="Background" Value="#17253A" />
      <Setter Property="BorderBrush" Value="#2B3C54" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="13,9" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#203149" /><Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#3A536F" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#263B53" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.48" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}" />
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
      <Setter Property="Background" Value="#087E76" />
      <Setter Property="BorderBrush" Value="#15998C" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#099589" /><Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#25B5A5" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#066A64" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.48" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#F1F5F9" />
      <Setter Property="Background" Value="#111C2D" />
      <Setter Property="BorderBrush" Value="#2B3C54" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#172235" />
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="OptionChrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="OptionChrome" Property="Background" Value="#D8F2EE" />
                <Setter Property="Foreground" Value="#0B4F4B" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="OptionChrome" Property="Background" Value="#C7E8E4" />
                <Setter Property="Foreground" Value="#0B4F4B" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#8995A5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#F1F5F9" />
      <Setter Property="Background" Value="#0C1422" />
      <Setter Property="BorderBrush" Value="#2B3C54" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="#55D6C2" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#C7D2E0" />
      <Setter Property="Padding" Value="11,9" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ItemChrome" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#17253A" /></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#17313B" /><Setter Property="Foreground" Value="#75E3D1" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="264" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#1B2A3D" BorderThickness="0,0,1,0">
      <Grid Margin="18,22,16,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="11" Background="#0E766F" Margin="0,0,11,0">
            <TextBlock Text="U" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Usb LLM" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="PRIVATE · LOCAL · YOURS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
          </StackPanel>
        </StackPanel>

        <Button Grid.Row="1" Content="＋   New private chat" Click="NewChat_Click" Style="{StaticResource PrimaryButtonStyle}"
                HorizontalContentAlignment="Left" Margin="0,26,0,0" Padding="14,12" />

        <TextBlock Grid.Row="2" Text="RECENT CHATS" FontSize="10" FontWeight="Bold"
                   Foreground="{StaticResource MutedBrush}" Margin="4,29,0,10" />

        <ListBox x:Name="SessionsList" Grid.Row="3" ItemsSource="{Binding Sessions}" DisplayMemberPath="Title"
                 SelectionChanged="SessionsList_SelectionChanged" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

        <Border Grid.Row="4" Background="#111C2D" BorderBrush="#24344A" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <Ellipse Width="7" Height="7" Fill="#55D6C2" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="Private session" FontWeight="SemiBold" FontSize="12" Foreground="#DCE6F2" />
            </StackPanel>
            <TextBlock Text="Chats stay in memory. Nothing is saved unless you export it." TextWrapping="Wrap"
                       FontSize="11" LineHeight="16" Foreground="{StaticResource MutedBrush}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Background="{StaticResource CanvasBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" BorderBrush="#1B2A3D" BorderThickness="0,0,0,1" Padding="28,17">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
            <TextBlock x:Name="ChatTitle" Text="New chat" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
            <TextBlock x:Name="HardwareSummary" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" />
          </StackPanel>
          <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
            <ComboBox x:Name="ModelSelector" Width="282" DisplayMemberPath="DisplayLabel" SelectionChanged="ModelSelector_SelectionChanged" />
            <Button x:Name="DownloadButton" Content="↓  Download model" Click="DownloadSelected_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="9,0,0,0" />
            <Button Content="Export chat" Click="ExportCurrent_Click" Margin="9,0,0,0" />
            <Button Content="Export all" Click="ExportAll_Click" Margin="7,0,0,0" />
          </WrapPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Background="#10212A" BorderBrush="#1A4A4C" BorderThickness="1" CornerRadius="9"
              Margin="28,15,28,0" Padding="13,10">
        <DockPanel LastChildFill="True">
          <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,5,10,0" />
          <TextBlock x:Name="DownloadStatus" Text="Private workspace ready. Choose a local model to download and start chatting."
                     Foreground="#B6D7D2" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Margin="28,22" Padding="0,0,12,0">
        <ItemsControl x:Name="MessagesList" ItemsSource="{Binding ActiveMessages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,14" Padding="18" CornerRadius="12" Background="{StaticResource PanelBrush}"
                      BorderBrush="#1D2C40" BorderThickness="1" MaxWidth="980" HorizontalAlignment="Left">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border Width="24" Height="24" CornerRadius="8" Background="#173B42" Margin="0,0,9,0">
                      <TextBlock Text="{Binding Speaker}" FontSize="10" FontWeight="Bold" Foreground="#75E3D1"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold" FontSize="12" Foreground="#B7C7D8" VerticalAlignment="Center" />
                  </StackPanel>
                  <local:MarkdownText Markdown="{Binding Body}" TextWrapping="Wrap" FontSize="14" Foreground="#E2E8F0" />
                  <Border Background="#09111D" BorderBrush="#22334A" BorderThickness="1" Padding="13" Margin="0,12,0,0"
                          CornerRadius="8" Visibility="{Binding CodeVisibility}">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="CODE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Content="Copy" Tag="{Binding Code}" Click="CopyCode_Click" DockPanel.Dock="Right" Padding="9,5" FontSize="11" />
                      </DockPanel>
                      <TextBox Text="{Binding Code, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Code" FontSize="13"
                               Background="Transparent" Foreground="#DCE6F2" BorderThickness="0" TextWrapping="NoWrap"
                               HorizontalScrollBarVisibility="Auto" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="#24344A" BorderThickness="1"
              CornerRadius="14" Padding="14" Margin="28,0,28,20">
        <StackPanel>
          <ItemsControl x:Name="AttachmentsList" ItemsSource="{Binding ActiveAttachments}" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="#17313B" BorderBrush="#24535A" BorderThickness="1" CornerRadius="7" Padding="9,5" Margin="0,0,7,5">
                  <TextBlock Text="{Binding DisplayName}" Foreground="#9CE5D9" FontSize="11" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="＋  Attach" Click="Attach_Click" Padding="12,10" />
              <Button Content="▧  Image" Click="GenerateImage_Click" Margin="7,0,0,0" Padding="12,10"
                      ToolTip="Uses image generation only when the selected local model supports it" />
            </StackPanel>
            <TextBox x:Name="PromptBox" Grid.Column="1" Margin="12,0" MinHeight="44" MaxHeight="150" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12,11" BorderBrush="#2A3B53"
                     Background="#0B1422" ToolTip="Write a message for your selected local model" />
            <Button x:Name="SendButton" Grid.Column="2" Content="Send  →" Click="Send_Click" Style="{StaticResource PrimaryButtonStyle}"
                    Padding="19,11" MinWidth="92" />
          </Grid>
          <DockPanel Margin="2,10,2,0">
            <TextBlock Text="Prompts and attachments are handled locally on this device." Foreground="{StaticResource MutedBrush}" FontSize="10" />
          </DockPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
